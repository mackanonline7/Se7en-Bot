{
  "expo": {
    "name": "Se7en Bot",
    "slug": "se7en-bot",
    "scheme": "se7en",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFFFFF",
          "dark": { "image": "./assets/splash-icon-dark.png", "backgroundColor": "#1C1C1E" }
        }
      ]
    ]
  }
}
